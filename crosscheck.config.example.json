{
  "$schema": "./schema/config.schema.json",
  "max_rounds": 3,
  "token_cap": 60000,
  "max_time_seconds": 180,
  "providers": ["anthropic", "openai", "xai"],
  "moderator": "anthropic",
  "temperature": 0.4,
  "log_transcripts": true,
  "transcript_dir": ".crosscheck/transcripts",
  "cache": {
    "enabled": true,
    "ttl_seconds": 604800,
    "max_entries": 5000,
    "dir": ".crosscheck/cache"
  },
  "session_db": ".crosscheck/sessions.sqlite3",
  "retries": {
    "max_attempts": 3,
    "backoff_base_s": 0.75
  },
  "rate_limits": {
    "default": {"capacity": 5, "refill_per_sec": 5}
  },
  "redaction": {
    "enabled": true,
    "patterns_extra": []
  },
  "provider_allowlist": null,
  "events_log": ".crosscheck/events.ndjson",
  "delegation": {
    "max_per_session": 50,
    "max_per_requester": 200
  },
  "bench": {
    "goldens_dir": ".crosscheck/goldens"
  },
  "fetch": {
    "enabled": true,
    "url_allowlist": [],
    "evidence_dir": ".crosscheck/evidence",
    "max_bytes": 10485760,
    "timeout_s": 15
  }
}
