{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crosscheck-agent tool surface",
  "description": "Single source of truth for the tools exposed over MCP (JSON-RPC 2.0 over stdio). Inputs are enforced at the server boundary; outputs are documented here and will be validated in P1.",
  "$defs": {
    "ProviderArrayArg": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ad-hoc subset of provider names (e.g. ['openai','gemini','xai']). Omit to use the configured active set. Call list_providers first if you're unsure which names are available."
    },
    "ProviderAnswer": {
      "type": "object",
      "description": "One provider's response (or its failure mode) for a single turn.",
      "properties": {
        "provider":      { "type": "string" },
        "model":         { "type": "string" },
        "response":      { "type": "string", "description": "The provider's text response. Mutually exclusive with `error`." },
        "error":         { "type": "string", "description": "Failure reason. Mutually exclusive with `response`." },
        "error_kind":    { "type": "string", "enum": ["auth", "rate_limit", "server", "client", "timeout", "network", "parse", "other"],
                           "description": "Classified failure mode; drives retry policy and reporting." },
        "retry_after_s": { "type": "number", "minimum": 0, "description": "When the upstream sent a Retry-After header." },
        "round":         { "type": "integer", "minimum": 1, "description": "Debate round number, when applicable." },
        "cache_hit":     { "type": "boolean", "description": "True if the response was served from the exact-match disk cache." },
        "elapsed_ms":    { "type": "integer", "minimum": 0, "description": "Wall-clock time the provider took (0 on cache hit)." },
        "attempts":      { "type": "integer", "minimum": 0, "description": "Number of HTTP attempts made (1 = first try succeeded)." }
      },
      "required": ["provider", "model"],
      "oneOf": [
        { "required": ["response"], "not": { "required": ["error"] } },
        { "required": ["error"],    "not": { "required": ["response"] } }
      ]
    },
    "BudgetSummary": {
      "type": "object",
      "description": "Per-call budget remaining at the moment the response was assembled.",
      "properties": {
        "wall_used_ms":      { "type": "integer", "minimum": 0 },
        "wall_remaining_ms": { "type": "integer", "minimum": 0 },
        "max_time_seconds":  { "type": "integer", "minimum": 1 },
        "token_cap":         { "type": "integer", "minimum": 1 },
        "cache_hits":        { "type": "integer", "minimum": 0 },
        "provider_calls":    { "type": "integer", "minimum": 0 }
      },
      "required": ["wall_used_ms", "wall_remaining_ms", "max_time_seconds", "token_cap"]
    },
    "RoleTurn": {
      "type": "object",
      "additionalProperties": false,
      "description": "Role envelope produced by a single proposer/critic turn in coordinate.",
      "properties": {
        "role":       { "type": "string", "enum": ["proposer", "critic"] },
        "summary":    { "type": "string", "description": "1-3 sentences capturing the position." },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim":      { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["claim", "confidence"]
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Overall confidence in the position." },
        "citations":  { "type": "array", "items": { "type": "string" } },
        "ballot":     { "type": "string", "enum": ["agree", "disagree", "abstain"],
                        "description": "Critic's stance on the proposal. Proposer always emits 'agree'." }
      },
      "required": ["role", "summary", "confidence"]
    },
    "StructuredSynthesis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Schema-validated synthesis output produced by the moderator/synthesizer role.",
      "properties": {
        "consensus":           { "type": "string", "description": "What the panel converged on." },
        "weighted_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "key_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim":      { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "supporters": { "type": "array", "items": { "type": "string" } },
              "dissenters": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["claim", "confidence"]
          }
        },
        "dissent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim":     { "type": "string" },
              "providers": { "type": "array", "items": { "type": "string" } },
              "rationale": { "type": "string" }
            },
            "required": ["claim", "providers"]
          }
        },
        "citations":      { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["consensus", "weighted_confidence", "key_claims"]
    },
    "SessionSummary": {
      "type": "object",
      "description": "Cumulative state for a session_id across calls.",
      "properties": {
        "session_id": { "type": "string" },
        "calls":      { "type": "integer", "minimum": 0 },
        "wall_ms":    { "type": "integer", "minimum": 0 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "started_at": { "type": "integer" },
        "last_at":    { "type": "integer" }
      },
      "required": ["session_id", "calls", "wall_ms", "cache_hits"]
    },
    "ProviderErrorEnvelope": {
      "type": "object",
      "description": "Returned when the caller asked for providers that aren't available; helps Claude self-correct.",
      "properties": {
        "error":                { "type": "string" },
        "unknown":              { "type": "array", "items": { "type": "string" } },
        "needs_api_key_in_env": { "type": "array", "items": { "type": "string" } },
        "unrecognised_names":   { "type": "array", "items": { "type": "string" } },
        "available_now":        { "type": "array", "items": { "type": "string" } }
      },
      "required": ["error"]
    }
  },
  "tools": {
    "list_providers": {
      "description": "List every provider the server knows about and whether each is currently usable (has an API key in .env). Call this first to discover who's on the panel.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name":      { "type": "string" },
                "available": { "type": "boolean" },
                "active":    { "type": "boolean" },
                "model":     { "type": ["string", "null"] }
              },
              "required": ["name", "available", "active", "model"]
            }
          },
          "moderator_default": { "type": ["string", "null"] },
          "usage_hint":        { "type": "string" }
        },
        "required": ["providers", "usage_hint"]
      }
    },
    "confer": {
      "description": "Ask one or more LLMs the same question and return their answers in parallel.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question":         { "type": "string", "description": "The question or prompt." },
          "context":          { "type": "string", "description": "Optional shared context." },
          "providers":        { "$ref": "#/$defs/ProviderArrayArg" },
          "session_id":       { "type": "string", "description": "Optional id to accumulate usage across calls." },
          "untrusted_input":  { "type": "boolean", "default": false,
                                "description": "When true, treat `context` and `question` as untrusted: wrap in tags, neutralize obvious injection phrases, instruct panelists to treat as data only." }
        },
        "required": ["question"]
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "tool":     { "const": "confer" },
              "question": { "type": "string" },
              "answers":  { "type": "array", "items": { "$ref": "#/$defs/ProviderAnswer" } },
              "budget":   { "$ref": "#/$defs/BudgetSummary" },
              "session":  { "$ref": "#/$defs/SessionSummary" },
              "transcript_path":           { "type": "string" },
              "transcript":                { "type": "string", "description": "Backwards-compatible alias for transcript_path." },
              "skipped_unknown_providers": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["tool", "question", "answers"]
          },
          { "$ref": "#/$defs/ProviderErrorEnvelope" }
        ]
      }
    },
    "debate": {
      "description": "Run a bounded multi-round debate across LLMs; moderator synthesises the result.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic":      { "type": "string" },
          "context":    { "type": "string" },
          "providers":  {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ad-hoc subset of provider names (e.g. ['openai','gemini','xai']). Omit to use the configured active set. Call list_providers first if you're unsure which names are available. Needs at least 2."
          },
          "max_rounds": { "type": "integer", "minimum": 1 },
          "moderator":  { "type": "string", "description": "Provider name to run the synthesis round. Defaults to config.moderator." },
          "session_id": { "type": "string", "description": "Optional id to accumulate usage across calls." },
          "structured": { "type": "boolean", "default": false,
                          "description": "If true, the moderator must emit a JSON object matching StructuredSynthesis. Validated server-side; one retry on failure with the validation errors fed back." }
        },
        "required": ["topic"]
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "tool":             { "const": "debate" },
              "topic":            { "type": "string" },
              "rounds_completed": { "type": "integer", "minimum": 0 },
              "transcript":       { "type": "array", "items": { "$ref": "#/$defs/ProviderAnswer" } },
              "synthesis":        { "anyOf": [{ "$ref": "#/$defs/ProviderAnswer" }, { "type": "null" }] },
              "synthesis_structured": { "anyOf": [{ "$ref": "#/$defs/StructuredSynthesis" }, { "type": "null" }] },
              "synthesis_errors":     { "type": "array", "items": { "type": "string" },
                                        "description": "Validation errors when structured=true and the synthesizer's output didn't match the schema after retry." },
              "budget":           { "$ref": "#/$defs/BudgetSummary" },
              "session":          { "$ref": "#/$defs/SessionSummary" },
              "transcript_path":  { "type": ["string", "null"] },
              "skipped_unknown_providers": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["tool", "topic", "rounds_completed", "transcript"]
          },
          { "$ref": "#/$defs/ProviderErrorEnvelope" }
        ]
      }
    },
    "plan": {
      "description": "Collaborative planning across LLMs with risks + alternatives.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "goal":        { "type": "string" },
          "constraints": { "type": "string" },
          "context":     { "type": "string" },
          "providers":   {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ad-hoc subset of provider names (e.g. ['openai','gemini','xai']). Omit to use the configured active set. Call list_providers first if you're unsure which names are available. Needs at least 2."
          },
          "moderator":   { "type": "string" },
          "session_id":  { "type": "string", "description": "Optional id to accumulate usage across calls." },
          "structured":  { "type": "boolean", "default": false,
                           "description": "If true, the moderator emits a JSON object matching StructuredSynthesis (validated server-side)." }
        },
        "required": ["goal"]
      },
      "output": { "$ref": "#/tools/debate/output" }
    },
    "coordinate": {
      "description": "Run a structured Proposer -> Critic(s) -> Synthesizer flow. The synthesizer's output is JSON-schema-validated; key claims, dissent, and open questions are persisted to the session claim-list when session_id is provided.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic":       { "type": "string", "description": "What to coordinate on (question, decision, design)." },
          "context":     { "type": "string" },
          "providers":   { "$ref": "#/$defs/ProviderArrayArg" },
          "proposer":    { "type": "string", "description": "Provider that drafts the initial proposal. Defaults to the first resolvable provider." },
          "critics":     { "type": "array", "items": { "type": "string" },
                           "description": "Providers that critique the proposal in parallel. Defaults to all selected providers minus proposer/synthesizer." },
          "synthesizer": { "type": "string", "description": "Provider that produces the final structured synthesis. Defaults to the configured moderator." },
          "session_id":  { "type": "string", "description": "Optional id; structured claims are persisted under this session." },
          "untrusted_input": { "type": "boolean", "default": false }
        },
        "required": ["topic"]
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "tool":          { "const": "coordinate" },
              "topic":         { "type": "string" },
              "roles":         {
                "type": "object",
                "properties": {
                  "proposer":    { "type": "string" },
                  "critics":     { "type": "array", "items": { "type": "string" } },
                  "synthesizer": { "type": "string" }
                },
                "required": ["proposer", "critics", "synthesizer"]
              },
              "proposal_answer":      { "$ref": "#/$defs/ProviderAnswer" },
              "proposal_structured":  { "anyOf": [{ "$ref": "#/$defs/RoleTurn" }, { "type": "null" }] },
              "critique_answers":     { "type": "array", "items": { "$ref": "#/$defs/ProviderAnswer" } },
              "critique_structured":  { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/RoleTurn" }, { "type": "null" }] } },
              "synthesis_answer":     { "anyOf": [{ "$ref": "#/$defs/ProviderAnswer" }, { "type": "null" }] },
              "synthesis_structured": { "anyOf": [{ "$ref": "#/$defs/StructuredSynthesis" }, { "type": "null" }] },
              "synthesis_errors":     { "type": "array", "items": { "type": "string" } },
              "budget":               { "$ref": "#/$defs/BudgetSummary" },
              "session":              { "$ref": "#/$defs/SessionSummary" },
              "transcript_path":      { "type": ["string", "null"] }
            },
            "required": ["tool", "topic", "roles"]
          },
          { "$ref": "#/$defs/ProviderErrorEnvelope" }
        ]
      }
    },
    "triangulate": {
      "description": "Run a Proposer/Critic/Synthesizer flow and return a consensus + minority report with per-provider weights drawn from accumulated ballot stats. Use this when you want one answer plus an honest dissenting view.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question":        { "type": "string" },
          "context":         { "type": "string" },
          "providers":       { "$ref": "#/$defs/ProviderArrayArg" },
          "session_id":      { "type": "string" },
          "untrusted_input": { "type": "boolean", "default": false }
        },
        "required": ["question"]
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "tool":                { "const": "triangulate" },
              "question":            { "type": "string" },
              "consensus":           { "type": "string" },
              "weighted_confidence": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
              "key_claims":          { "type": "array" },
              "dissent":             { "type": "array" },
              "minority_report":     { "type": "string" },
              "open_questions":      { "type": "array", "items": { "type": "string" } },
              "panel": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "provider": { "type": "string" },
                    "weight":   { "type": "number", "minimum": 0, "maximum": 1 }
                  },
                  "required": ["provider", "weight"]
                }
              },
              "providers_used":   { "type": "array", "items": { "type": "string" } },
              "roles":            { "type": "object" },
              "synthesis_errors": { "type": "array", "items": { "type": "string" } },
              "budget":           { "$ref": "#/$defs/BudgetSummary" },
              "session":          { "$ref": "#/$defs/SessionSummary" },
              "transcript_path":  { "type": ["string", "null"] }
            },
            "required": ["tool", "question", "consensus", "panel", "providers_used"]
          },
          { "$ref": "#/$defs/ProviderErrorEnvelope" }
        ]
      }
    },
    "review": {
      "description": "Peer-review a code snippet or proposal across one or more LLMs.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snippet":         { "type": "string" },
          "intent":          { "type": "string" },
          "providers":       { "$ref": "#/$defs/ProviderArrayArg" },
          "session_id":      { "type": "string", "description": "Optional id to accumulate usage across calls." },
          "untrusted_input": { "type": "boolean", "default": false,
                               "description": "When true, treat the snippet as untrusted: wrap in tags, neutralize obvious injection phrases, instruct panelists to treat as data only. Use for snippets from outside contributors, user submissions, or anything you wouldn't run as a script." }
        },
        "required": ["snippet"]
      },
      "output": { "$ref": "#/tools/confer/output" }
    }
  }
}
