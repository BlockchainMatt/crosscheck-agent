{
  "module": "utils",
  "description": "small utility helpers parity",
  "case_count": 50,
  "sid_cases": [
    {
      "label": "sid::00",
      "input": "",
      "expected": "default"
    },
    {
      "label": "sid::01",
      "input": "default",
      "expected": "default"
    },
    {
      "label": "sid::02",
      "input": "abc-123_xyz.456",
      "expected": "abc-123_xyz.456"
    },
    {
      "label": "sid::03",
      "input": "has spaces and stuff!@#$",
      "expected": "hasspacesandstuff"
    },
    {
      "label": "sid::04",
      "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "expected": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "label": "sid::05",
      "input": "_._._._",
      "expected": "_._._._"
    },
    {
      "label": "sid::06",
      "input": "你好 alpha",
      "expected": "alpha"
    },
    {
      "label": "sid::07",
      "input": "/abs/path/like/this",
      "expected": "abspathlikethis"
    },
    {
      "label": "sid::08",
      "input": "ALLCAPS123",
      "expected": "ALLCAPS123"
    }
  ],
  "per_call_cases": [
    {
      "label": "per_call::1-call-default-8000",
      "calls": 1,
      "cfg": null,
      "expected": 8000
    },
    {
      "label": "per_call::4-calls-default",
      "calls": 4,
      "cfg": null,
      "expected": 2000
    },
    {
      "label": "per_call::10-calls-default",
      "calls": 10,
      "cfg": null,
      "expected": 800
    },
    {
      "label": "per_call::floor-256",
      "calls": 100,
      "cfg": null,
      "expected": 256
    },
    {
      "label": "per_call::zero-calls-treated-as-1",
      "calls": 0,
      "cfg": null,
      "expected": 8000
    },
    {
      "label": "per_call::negative-clamped",
      "calls": -5,
      "cfg": null,
      "expected": 8000
    },
    {
      "label": "per_call::explicit-16k-cap",
      "calls": 1,
      "cfg": {
        "token_cap": 16000
      },
      "expected": 16000
    },
    {
      "label": "per_call::small-cap-256-floor",
      "calls": 4,
      "cfg": {
        "token_cap": 1024
      },
      "expected": 256
    }
  ],
