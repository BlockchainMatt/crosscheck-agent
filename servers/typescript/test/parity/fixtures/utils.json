  "breaker_cases": [
    {
      "label": "breaker::null-session",
      "session": null,
      "cfg": {
        "max_session_cost_usd": 1.0
      },
      "expected": null
    },
    {
      "label": "breaker::no-cfg",
      "session": {
        "total_cost_usd": 0.5
      },
      "cfg": {},
      "expected": null
    },
    {
      "label": "breaker::under-cost",
      "session": {
        "total_cost_usd": 0.5
      },
      "cfg": {
        "max_session_cost_usd": 1.0
      },
      "expected": null
    },
    {
      "label": "breaker::over-cost",
      "session": {
        "total_cost_usd": 1.5
      },
      "cfg": {
        "max_session_cost_usd": 1.0
      },
      "expected": {
        "name": "max_session_cost_usd",
        "reason": "session cost $1.5000 >= cap $1.0000"
      }
    },
    {
      "label": "breaker::under-tokens",
      "session": {
        "total_tokens": 500
      },
      "cfg": {
        "max_session_tokens": 1000
      },
      "expected": null
    },
    {
      "label": "breaker::over-tokens",
      "session": {
        "total_tokens": 1500
      },
      "cfg": {
        "max_session_tokens": 1000
      },
      "expected": {
        "name": "max_session_tokens",
        "reason": "session tokens 1500 >= cap 1000"
      }
    },
    {
      "label": "breaker::under-wall",
      "session": {
        "wall_ms": 5000
      },
      "cfg": {
        "max_session_wall_seconds": 10
      },
      "expected": null
    },
    {
      "label": "breaker::over-wall",
      "session": {
        "wall_ms": 15000
      },
      "cfg": {
        "max_session_wall_seconds": 10
      },
      "expected": {
        "name": "max_session_wall_seconds",
        "reason": "session wall 15000ms >= cap 10000ms"
      }
    },
    {
      "label": "breaker::all-three-tripped-cost-first",
      "session": {
        "total_cost_usd": 2.0,
        "total_tokens": 2000,
        "wall_ms": 99999
      },
      "cfg": {
        "max_session_cost_usd": 1.0,
        "max_session_tokens": 1000,
        "max_session_wall_seconds": 10
      },
      "expected": {
        "name": "max_session_cost_usd",
        "reason": "session cost $2.0000 >= cap $1.0000"
      }
    }
  ],
  "dag_cases": [
    {
      "label": "dag::no-cfg",
      "dag": {
        "nodes": [
          {
            "id": "a"
          },
          {
            "id": "b"
          },
          {
            "id": "c"
          }
        ]
      },
      "cfg": {},
      "expected": null
    },
    {
      "label": "dag::under-nodes",
      "dag": {
        "nodes": [
          {
            "id": "a"
          }
        ]
      },
      "cfg": {
        "max_dag_nodes": 5
      },
      "expected": null
    },
    {
      "label": "dag::over-nodes",
      "dag": {
        "nodes": [
          {
            "id": "a"
          },
          {
            "id": "b"
          },
          {
            "id": "c"
          },
          {
            "id": "d"
          },
          {
            "id": "e"
          },
          {
            "id": "f"
          },
          {
            "id": "g"
          },
          {
            "id": "h"
          },
          {
            "id": "i"
          }
        ]
      },
      "cfg": {
        "max_dag_nodes": 5
      },
      "expected": {
        "name": "max_dag_nodes",
        "reason": "dag has 9 nodes > cap 5"
      }
    },
    {
      "label": "dag::depth-exceeds",
      "dag": {
        "nodes": [
          {
            "id": "a"
          },
          {
            "id": "b",
            "depends_on": [
              "a"
            ]
          },
          {
            "id": "c",
            "depends_on": [
              "b"
            ]
          }
        ]
      },
      "cfg": {
        "max_dag_depth": 2
      },
      "expected": {
        "name": "max_dag_depth",
        "reason": "dag depth 3 > cap 2"
      }
    },
    {
      "label": "dag::depth-under-cap",
      "dag": {
        "nodes": [
          {
            "id": "a"
          },
          {
            "id": "b",
            "depends_on": [
              "a"
            ]
          }
        ]
      },
      "cfg": {
        "max_dag_depth": 5
      },
      "expected": null
    },
    {
      "label": "dag::cycle-fail-closed",
      "dag": {
        "nodes": [
          {
            "id": "a",
            "depends_on": [
              "b"
            ]
          },
          {
            "id": "b",
            "depends_on": [
              "a"
            ]
          }
        ]
      },
      "cfg": {
        "max_dag_depth": 5
      },
      "expected": {
        "name": "max_dag_depth",
        "reason": "cycle detected at node a; depth can't be bounded — fail-closed (this normally means _validate_dag missed it)"
      }
    },
    {
      "label": "dag::cycle-but-no-depth-cap",
      "dag": {
        "nodes": [
          {
            "id": "a",
            "depends_on": [
              "b"
            ]
          },
          {
            "id": "b",
            "depends_on": [
              "a"
            ]
          }
        ]
      },
      "cfg": {},
      "expected": null
    }
  ],
