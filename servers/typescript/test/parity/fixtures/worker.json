{
  "module": "worker",
  "description": "worker tool-use pure-function pieces parity",
  "case_count": 56,
  "cap_cases": [
    {
      "label": "cap::defaults-no-cap",
      "caller_cap": null,
      "caller_mode": null,
      "cfg": null,
      "expected": {
        "cap_usd": null,
        "mode": "warn"
      }
    },
    {
      "label": "cap::cap-warn-default",
      "caller_cap": 0.5,
      "caller_mode": null,
      "cfg": null,
      "expected": {
        "cap_usd": 0.5,
        "mode": "warn"
      }
    },
    {
      "label": "cap::cap-enforce",
      "caller_cap": 0.5,
      "caller_mode": "enforce",
      "cfg": null,
      "expected": {
        "cap_usd": 0.5,
        "mode": "enforce"
      }
    },
    {
      "label": "cap::cap-off",
      "caller_cap": 0.5,
      "caller_mode": "off",
      "cfg": null,
      "expected": {
        "cap_usd": 0.5,
        "mode": "off"
      }
    },
    {
      "label": "cap::cfg-cap-only",
      "caller_cap": null,
      "caller_mode": null,
      "cfg": {
        "cost_cap_usd": 1.0
      },
      "expected": {
        "cap_usd": 1.0,
        "mode": "warn"
      }
    },
    {
      "label": "cap::cfg-cap-and-mode",
      "caller_cap": null,
      "caller_mode": null,
      "cfg": {
        "cost_cap_usd": 1.0,
        "cost_cap_mode": "enforce"
      },
      "expected": {
        "cap_usd": 1.0,
        "mode": "enforce"
      }
    },
    {
      "label": "cap::caller-mode-beats-cfg",
      "caller_cap": null,
      "caller_mode": "warn",
      "cfg": {
        "cost_cap_usd": 1.0,
        "cost_cap_mode": "enforce"
      },
      "expected": {
        "cap_usd": 1.0,
        "mode": "warn"
      }
    },
    {
      "label": "cap::caller-cap-beats-cfg",
      "caller_cap": 2.0,
      "caller_mode": null,
      "cfg": {
        "cost_cap_usd": 1.0
      },
      "expected": {
        "cap_usd": 2.0,
        "mode": "warn"
      }
    },
    {
      "label": "cap::invalid-cap-str",
      "caller_cap": "abc",
      "caller_mode": null,
      "cfg": null,
      "expected": {
        "cap_usd": null,
        "mode": "warn"
      }
    },
    {
      "label": "cap::zero-cap-disables",
      "caller_cap": 0,
      "caller_mode": null,
      "cfg": null,
      "expected": {
        "cap_usd": null,
        "mode": "warn"
      }
    },
    {
      "label": "cap::negative-cap-disables",
      "caller_cap": -1.0,
      "caller_mode": null,
      "cfg": null,
      "expected": {
        "cap_usd": null,
        "mode": "warn"
      }
    },
    {
      "label": "cap::invalid-mode-falls-to-warn",
      "caller_cap": 1.0,
      "caller_mode": "bogus",
      "cfg": null,
      "expected": {
        "cap_usd": 1.0,
        "mode": "warn"
      }
    },
    {
      "label": "cap::empty-mode-falls-to-warn",
      "caller_cap": 1.0,
      "caller_mode": "",
      "cfg": null,
      "expected": {
        "cap_usd": 1.0,
        "mode": "warn"
      }
    }
  ],
